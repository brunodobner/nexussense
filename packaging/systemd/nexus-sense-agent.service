[Unit]
Description=Nexus Sense — perfis de energia e modo de desempenho máximo
Documentation=file:/usr/share/doc/nexus-sense/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# O agente avisa a cada passada que esta vivo (guarda.py). O que para de
# avisar -- travado, mas vivo -- o WatchdogSec mata. SIGKILL, e nao o SIGABRT
# padrao: o SIGABRT faz core dump, e o systemd-coredump atrasaria o guarda.
# 6 s sao tres passadas; com uma unit descartavel, em 2026-10-15, o processo
# parado teve o 0,0 de volta em 5,8 s.
Type=notify
ExecStart=/usr/bin/nexus-sense-agent
WatchdogSec=6
WatchdogSignal=SIGKILL
# O guarda da ventoinha (docs/plano-curva.md, secao 8). Em toda parada do
# agente -- logout, kill -9, falta de memoria, watchdog -- devolve o
# automatico, mas so se fan_speed estiver num manual que o PROPRIO agente
# registrou ter escrito. O registro mora no RuntimeDirectory: o
# ProtectSystem=strict o deixa gravavel, e o systemd so o apaga depois do
# ExecStopPost.
ExecStopPost=/usr/lib/nexus-sense/guarda-ventoinha.sh
RuntimeDirectory=nexus-sense
Restart=always
RestartSec=3
# Não precisa de privilégio: escreve pelo grupo nexus_sense, aplicado
# pela regra udev 60-nexus-sense.rules.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# A excecao que o read-only exige: o agente grava o perfil de tomada em
# ~/.config/nexus-sense/. Sem esta linha ele nao consegue, e o perfil nao
# volta depois de um reinicio -- medido na virada. O "-" torna a ausencia
# do diretorio nao-fatal, e ~/.config e o menor caminho que sempre existe
# e permite ao agente criar o proprio subdiretorio.
ReadWritePaths=-%h/.config
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
